{
  "name": "@decoy/sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DECOY SDK: domain types, protocol parameters, rules, and a client that runs on a backend.",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
