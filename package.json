{
  "name": "@decoy/sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DECOY SDK: domain types, protocol parameters, rules, and a client that runs on a backend.",
  "exports": {
    ".": "./src/index.ts",
    "./prove": "./src/prove/index.ts",
    "./assets/*": "./assets/*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260522",
    "@decoy/protocol": "0.1.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noir-lang/noir_js": "1.0.0-beta.22",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
